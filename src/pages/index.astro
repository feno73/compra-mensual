---
import Dashboard from "../components/Dashboard.astro";
import { createDashboardModel } from "../domain/view-model";
import { loadPurchaseMonths } from "../domain/purchases/load";
import BaseLayout from "../layouts/BaseLayout.astro";
const months = await loadPurchaseMonths();
const latest = months.at(-1);
if (!latest) throw new Error("No hay meses cargados");
const model = createDashboardModel(months, latest.month);
---
<BaseLayout title="Compras mensuales" description="Historial y comparación de compras mensuales de supermercado"><Dashboard model={model} /></BaseLayout>
