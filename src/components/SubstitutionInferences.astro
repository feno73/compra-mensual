---
import { formatArs } from "../domain/money";
import type { compareAggregates } from "../domain/comparison/compare";
interface Props { substitutions: ReturnType<typeof compareAggregates>["substitutions"] }
const { substitutions } = Astro.props;
const names = (products: typeof substitutions[number]["currentProducts"]) => products.map((product) => product.name).join(" + ");
const impact = (change: bigint) => change < 0n ? `${formatArs(-change)} menos` : `${formatArs(change)} más`;
---
<section class="panel compact" aria-labelledby="sustituciones-titulo">
  <p class="eyebrow">Reclasificadas en la comparación</p><h2 id="sustituciones-titulo">Reemplazos confirmados</h2>
  {substitutions.length === 0 ? <p class="empty-state">No se registraron reemplazos confirmados para este mes.</p> : (
    <div class="price-history-grid">
      {substitutions.map((item) => (
        <article class="price-card">
          <p class="replacement-kind">{item.kind === "equivalent" ? "Equivalente" : "Renovación de grupo"}</p>
          <h3>{item.reason}</h3>
          {item.id === "leche-proteica" ? (
            <p>Cambiaste 6 leches proteicas La Serenísima por 6 Las Tres Niñas y pagaste <strong>{impact(item.changeCents)}</strong> en total.</p>
          ) : (
            <p><strong>{names(item.previousProducts)}</strong> → <strong>{names(item.currentProducts)}</strong></p>
          )}
          <p class="replacement-basis">{item.comparisonBasis}</p>
          <dl>
            <div><dt>Antes</dt><dd>{formatArs(item.previousNetCents)}</dd></div>
            <div><dt>Ahora</dt><dd>{formatArs(item.currentNetCents)}</dd></div>
            <div><dt>Impacto</dt><dd class:list={{ negative: item.changeCents < 0n, positive: item.changeCents > 0n }}>{impact(item.changeCents)}</dd></div>
          </dl>
          <small>Bruto {formatArs(item.previousGrossCents)} → {formatArs(item.currentGrossCents)} · Descuentos {formatArs(item.previousDiscountCents)} → {formatArs(item.currentDiscountCents)}</small>
        </article>
      ))}
    </div>
  )}
</section>
<style>.replacement-kind{color:var(--green);font-size:.7rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;margin-bottom:.4rem}.replacement-basis{color:var(--muted);font-size:.82rem}.price-card>small{display:block;margin-top:.8rem}</style>
