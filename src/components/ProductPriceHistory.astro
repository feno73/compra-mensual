---
import { formatArs } from "../domain/money";
import type { buildProductPriceHistory } from "../domain/history";
type Histories = ReturnType<typeof buildProductPriceHistory>;
interface Props {
  histories: Histories;
  replacementHistories: Array<{ id: string; label: string; comparisonBasis: string; points: Array<{ month: string; netUnitCents: bigint }> }>;
}
const { histories, replacementHistories } = Astro.props;
---
<section class="panel" aria-labelledby="precios-titulo">
  <p class="eyebrow">Productos presentes en más de un mes</p><h2 id="precios-titulo">Historial de precios habituales</h2>
  <div class="price-history-grid">
    {replacementHistories.map((history) => (
      <article class="price-card">
        <p class="eyebrow">Continuidad por reemplazo</p><h3>{history.label}</h3><small>{history.comparisonBasis}</small>
        <dl>{history.points.map((point) => <div><dt>{point.month}</dt><dd><strong>{formatArs(point.netUnitCents)}</strong><small>Neto por unidad comprada</small></dd></div>)}</dl>
      </article>
    ))}
    {histories.map((history) => (
      <article class="price-card">
        <h3>{history.name}</h3><small>Precio por {history.unit === "unit" ? "unidad" : history.unit}</small>
        <dl>{history.points.map((point) => <div><dt>{point.month}</dt><dd><strong>{formatArs(point.netUnitCents)}</strong><small>Lista {formatArs(point.grossUnitCents)}</small></dd></div>)}</dl>
      </article>
    ))}
  </div>
</section>
